{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FauxCode",
  "version": "1.0.0",
  "identifier": "com.fauxcode.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "FauxCode",
        "width": 1440,
        "height": 900,
        "maximized": false,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
